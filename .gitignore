# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Generated notebook output (re-derivable; not source)
notebooks/temp_output/

# Claude Code: personal/local settings stay local
.claude/settings.local.json

# Build metadata (regenerated by every editable install)
scqat.egg-info/
*.egg-info/

# Resolver lockfile — deliberately NOT committed. scqat is a LIBRARY that other
# repos import, so pinning its transitive tree here would only describe one
# developer's machine; the consuming applications (SCQO, LCHQBDriver) own the
# locks that actually matter. Regenerate locally with `uv lock` / `uv sync`.
uv.lock
